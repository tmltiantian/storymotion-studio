LLM_PROVIDER=gateway
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://ops-ai-gateway.yc345.tv
OPENAI_BASE_URL=https://ops-ai-gateway.yc345.tv/v1
OPENAI_MODEL=qwen3.6-plus

IMAGE_PROVIDER=gateway
GATEWAY_IMAGE_MODEL=qwen-image-2.0
# Source-locked pet replica anchors always use this still model and size.
# The replica workflow only calls the gateway when its explicit enable_live gate is true.
REPLICA_IMAGE_MODEL=doubao-seedream-4-5
REPLICA_IMAGE_SIZE=1440x2560
REPLICA_ENABLE_LIVE=0

# Live requests still require --enable-live.
# A one-off CLI --model value overrides this default without editing dotenv.
VIDEO_PROVIDER=gateway
GATEWAY_VIDEO_MODEL=doubao-seedance-2-0-fast
ENABLE_GATEWAY_VIDEO=1
# Character-reference production video model: doubao-seedance-2-0
# doubao-seedance-1-5-pro is listed by the gateway but rejects r2v reference tasks.
# Production still model: doubao-seedream-4-5
# Experimental still route: gpt-image-2 (gateway returned HTTP 504 in the latest probe).

# Official MiniMax H3 video API. Set VIDEO_PROVIDER=minimax to use this route.
# Live requests still require --enable-live and ENABLE_MINIMAX_VIDEO=1.
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_VIDEO_MODEL=MiniMax-H3
ENABLE_MINIMAX_VIDEO=0

TTS_PROVIDER=auto
LOCAL_TTS_RATE=165
DOUBAO_SPEECH_API_KEY=
DOUBAO_SPEECH_VOICE_TYPE=
# Legacy credentials used by the verified Onion sample streaming route.
DOUBAO_TTS_APPID=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_SPEECH_RATE=-4
DOUBAO_TTS_CONTEXT=自然克制的中文漫剧表演，语气真实，停顿清楚，避免广告腔和机械朗读。
# Optional JSON map. These three Seed-TTS 2.0 voices were verified together
# with the Onion sample AppID/AccessKey route on 2026-07-15.
DOUBAO_SPEECH_VOICE_MAP={"narrator":"zh_female_santongyongns_saturn_bigtts","character_1":"zh_male_ruyayichen_saturn_bigtts","character_2":"zh_female_vv_uranus_bigtts"}
